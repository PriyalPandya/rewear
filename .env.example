# ================================================================
# ReWear — Environment Variables Configuration
# Copy this file to .env.local and fill in your Supabase credentials
# ================================================================

# Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Client Key (public, safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-api-key-here

# Supabase Service Role Key (server-only, bypasses RLS for backend routes)
# IMPORTANT: Never prefix with NEXT_PUBLIC_ or expose in client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Application Base URL (used for metadata and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
